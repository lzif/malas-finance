# MalasFinance v3 — environment variables.
#
# Copy to `.env` (gitignored) and fill in real values, then push them to the
# Deno Deploy app in one command so you never touch the dashboard:
#
#   deno deploy env load .env --app malas-finance
#
# For local work, `set -a && . ./.env && set +a` loads them into the shell.

# --- Provided by the platform, do NOT set by hand ---
# The Deno Deploy built-in Postgres injects DATABASE_URL (and PGHOST/PGPORT/…)
# automatically at runtime. Set it here only for LOCAL runs against your own
# Postgres (deno task db:migrate, deno task test:integration).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Secrets you must provide ---
# Google AI Studio key for the Gemini parser (bot/parser.ts).
GOOGLE_AI_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Shared secret set as `secret_token` on setWebhook; grammY checks it against
# the X-Telegram-Bot-Api-Secret-Token header. The webhook fails closed without
# it — pick a long random string.
TELEGRAM_WEBHOOK_SECRET=
