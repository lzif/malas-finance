{
  "name": "malas-finance",
  "version": "3.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "test": "deno test",
    "check": "deno check src/**/*.ts",
    "dev": "deno serve --watch --allow-net --allow-env src/main.ts",
    "start": "deno serve --allow-net --allow-env src/main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/testing": "jsr:@std/testing@^1.0.16"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
